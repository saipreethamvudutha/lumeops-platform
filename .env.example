# LumeOps Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ── Application ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Security (REQUIRED - generate unique values) ─────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_random_string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CHANGE_ME_generate_a_32_byte_random_string

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:lumeops_dev_password@localhost:5432/lumeops
DB_PASSWORD=lumeops_dev_password

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS (Optional for local dev) ─────────────────────────────────
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=
# AWS_S3_BUCKET=lumeops-data
# AWS_S3_REPORTS_BUCKET=lumeops-reports

# ── Alerts (Optional) ───────────────────────────────────────────
# ALERT_EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_FROM_EMAIL=alerts@lumeops.io
# ALERT_SLACK_ENABLED=false
