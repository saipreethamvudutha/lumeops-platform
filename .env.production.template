# ──────────────────────────────────────────────────────────────────────────────
# LumeOps Production Environment Variables
#
# Copy this file to .env.production and fill in the values.
# NEVER commit the actual .env.production file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=          # REQUIRED: Strong password for PostgreSQL

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=       # REQUIRED: Strong password for Redis

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTIC_PASSWORD=     # REQUIRED: Strong password for Elasticsearch

# ── Application Secrets ──────────────────────────────────────────────────────
SECRET_KEY=           # REQUIRED: Random 64+ character string for JWT/session signing
ENCRYPTION_KEY=       # REQUIRED: Random 64+ character string for data encryption

# ── Application Config ──────────────────────────────────────────────────────
LOG_LEVEL=WARNING
API_WORKERS=4         # Number of uvicorn worker processes (2x CPU cores recommended)
ALLOWED_ORIGINS=https://lumeops.example.com  # Comma-separated allowed CORS origins

# ── TLS Certificates ────────────────────────────────────────────────────────
# Place your TLS certificates in ./nginx/certs/:
#   fullchain.pem  - Certificate chain (including intermediates)
#   privkey.pem    - Private key
#
# For Let's Encrypt, use certbot:
#   certbot certonly --standalone -d lumeops.example.com
#   cp /etc/letsencrypt/live/lumeops.example.com/fullchain.pem ./nginx/certs/
#   cp /etc/letsencrypt/live/lumeops.example.com/privkey.pem ./nginx/certs/
